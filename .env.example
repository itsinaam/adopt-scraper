# ==============================================================================
# Environment Configuration Template for Adapt.io Backend
# Copy this file to .env for local development or set in Railway Variables tab.
# ==============================================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app,http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOW_ALL=true
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Database Settings (PostgreSQL) ---
# Supabase Pooler URL or Railway PostgreSQL connection URL:
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Supabase Storage (for scraped CSV artifact uploads) ---
SUPABASE_URL=https://your-project.supabase.co
# Use service role key or anon key with storage permissions
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_STORAGE_BUCKET=results

# --- Playwright Configuration ---
PLAYWRIGHT_HEADLESS=true

# --- Webshare Residential / Datacenter Proxy (Optional for Adapt.io) ---
WEBSHARE_PROXY_SERVER=http://proxy-host:proxy-port
WEBSHARE_PROXY_USERNAME=your-webshare-username
WEBSHARE_PROXY_PASSWORD=your-webshare-password

# --- MailTester Ninja REST API Verification ---
# Subscription API key from https://mailtester.ninja/
MAILTESTER_API_KEY=your-mailtester-ninja-api-key
MAILTESTER_CONCURRENCY=2
# Set to true to verify candidates via MailTester Early-Stop API, or false to bypass verification and export all combinations directly
ENABLE_MAILTESTER_VERIFICATION=true



