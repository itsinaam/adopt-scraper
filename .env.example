DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
PLAYWRIGHT_HEADLESS=true

# Database (Supabase PostgreSQL Connection URL)
DATABASE_URL=postgresql://postgres.your-project:password@aws-1-region.pooler.supabase.com:6543/postgres

# Supabase Storage & Services
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_STORAGE_BUCKET=results

# Webshare proxy. Keep real values only in .env.
WEBSHARE_PROXY_SERVER=http://proxy-host:proxy-port
WEBSHARE_PROXY_USERNAME=replace-me
WEBSHARE_PROXY_PASSWORD=replace-me

MAILTESTER_CLIENT_PATH=mailtester/mailtesterninjaapp.exe
MAILTESTER_KEY_PATH=mailtester/key.txt
MAILTESTER_TIMEOUT_SECONDS=3600
